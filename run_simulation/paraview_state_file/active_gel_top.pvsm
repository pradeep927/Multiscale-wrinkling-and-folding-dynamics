    <Proxy group="filters" type="ProgrammableFilter" id="15354" servers="1">
      <Property name="CopyArrays" id="15354.CopyArrays" number_of_elements="1">
        <Element index="0" value="0"/>
        <Domain name="bool" id="15354.CopyArrays.bool"/>
      </Property>
      <Property name="InformationScript" id="15354.InformationScript" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Input" id="15354.Input" number_of_elements="1">
        <Proxy value="15118" output_port="0"/>
        <Domain name="groups" id="15354.Input.groups"/>
        <Domain name="input_type" id="15354.Input.input_type"/>
      </Property>
      <Property name="OutputDataSetType" id="15354.OutputDataSetType" number_of_elements="1">
        <Element index="0" value="8"/>
        <Domain name="enum" id="15354.OutputDataSetType.enum">
          <Entry value="8" text="Same as Input"/>
          <Entry value="0" text="vtkPolyData"/>
          <Entry value="2" text="vtkStructuredGrid"/>
          <Entry value="3" text="vtkRectilinearGrid"/>
          <Entry value="4" text="vtkUnstructuredGrid"/>
          <Entry value="6" text="vtkImageData"/>
          <Entry value="10" text="vtkUniformGrid"/>
          <Entry value="13" text="vtkMultiblockDataSet"/>
          <Entry value="15" text="vtkHierarchicalBoxDataSet"/>
          <Entry value="32" text="vtkHyperTreeGrid"/>
          <Entry value="19" text="vtkTable"/>
          <Entry value="33" text="vtkMolecule"/>
          <Entry value="37" text="vtkPartitionedDataSet"/>
          <Entry value="38" text="vtkPartitionedDataSetCollection"/>
        </Domain>
      </Property>
      <Property name="PythonPath" id="15354.PythonPath" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Script" id="15354.Script" number_of_elements="1">
        <Element index="0" value="import numpy as np&#xa;import vtk&#xa;from vtk.numpy_interface import dataset_adapter as dsa&#xa;&#xa;inp = self.GetInput()&#xa;out = self.GetOutput()&#xa;&#xa;out.ShallowCopy(inp)&#xa;&#xa;wrapped = dsa.WrapDataObject(inp)&#xa;&#xa;# ---------------------------------------------------&#xa;# CURRENT COORDINATES&#xa;# ---------------------------------------------------&#xa;&#xa;pts = wrapped.Points&#xa;&#xa;# ---------------------------------------------------&#xa;# DISPLACEMENT FIELD&#xa;# ---------------------------------------------------&#xa;&#xa;Ux = wrapped.PointData[&#x22;Displacement&#x22;][:,0]&#xa;Uy = wrapped.PointData[&#x22;Displacement&#x22;][:,1]&#xa;Uz = wrapped.PointData[&#x22;Displacement&#x22;][:,2]&#xa;&#xa;# ---------------------------------------------------&#xa;# REFERENCE COORDINATES&#xa;#&#xa;# X = x - u&#xa;# ---------------------------------------------------&#xa;&#xa;Xr = pts[:,0] - Ux&#xa;Yr = pts[:,1] - Uy&#xa;Zr = pts[:,2] - Uz&#xa;&#xa;npts = len(Xr)&#xa;&#xa;# ---------------------------------------------------&#xa;# BUILD CONNECTIVITY GRAPH&#xa;# ---------------------------------------------------&#xa;&#xa;neighbors = [[] for _ in range(npts)]&#xa;&#xa;for i in range(inp.GetNumberOfCells()):&#xa;&#xa;    cell = inp.GetCell(i)&#xa;&#xa;    ids = cell.GetPointIds()&#xa;&#xa;    if ids.GetNumberOfIds() != 2:&#xa;        continue&#xa;&#xa;    a = ids.GetId(0)&#xa;    b = ids.GetId(1)&#xa;&#xa;    neighbors[a].append(b)&#xa;    neighbors[b].append(a)&#xa;&#xa;# ---------------------------------------------------&#xa;# FIND ENDPOINT&#xa;# ---------------------------------------------------&#xa;&#xa;start = 0&#xa;&#xa;for i in range(npts):&#xa;&#xa;    if len(neighbors[i]) == 1:&#xa;        start = i&#xa;        break&#xa;&#xa;# ---------------------------------------------------&#xa;# WALK ALONG CURVE&#xa;# ---------------------------------------------------&#xa;&#xa;order = []&#xa;&#xa;current = start&#xa;prev = -1&#xa;&#xa;while True:&#xa;&#xa;    order.append(current)&#xa;&#xa;    nxts = [x for x in neighbors[current] if x != prev]&#xa;&#xa;    if len(nxts) == 0:&#xa;        break&#xa;&#xa;    nxt = nxts[0]&#xa;&#xa;    prev = current&#xa;    current = nxt&#xa;&#xa;# ---------------------------------------------------&#xa;# MATERIAL ARC LENGTH&#xa;# ---------------------------------------------------&#xa;&#xa;s = np.zeros(npts)&#xa;&#xa;for k in range(1, len(order)):&#xa;&#xa;    i0 = order[k-1]&#xa;    i1 = order[k]&#xa;&#xa;    p0 = np.array([Xr[i0], Yr[i0], Zr[i0]])&#xa;    p1 = np.array([Xr[i1], Yr[i1], Zr[i1]])&#xa;&#xa;    ds = np.linalg.norm(p1 - p0)&#xa;&#xa;    s[i1] = s[i0] + ds&#xa;&#xa;# ---------------------------------------------------&#xa;&#xa;out.GetPointData().AddArray(&#xa;    dsa.numpyTovtkDataArray(s, &#x22;s_ref&#x22;)&#xa;)"/>
      </Property>
      <Property name="TimestepValues" id="15354.TimestepValues" number_of_elements="901">
