      <Property name="PythonPath" id="15590.PythonPath" number_of_elements="1">
        <Element index="0" value=""/>
      </Property>
      <Property name="Script" id="15590.Script" number_of_elements="1">
        <Element index="0" value="import numpy as np&#xa;import vtk&#xa;from vtk.numpy_interface import dataset_adapter as dsa&#xa;&#xa;inp = self.GetInput()&#xa;out = self.GetOutput()&#xa;&#xa;wrapped = dsa.WrapDataObject(inp)&#xa;&#xa;# material arc length&#xa;s = wrapped.PointData[&#x22;s_ref&#x22;]&#xa;&#xa;# undeformed reference points&#xa;pts_ref = wrapped.Points&#xa;&#xa;# deformed coordinates&#xa;Xd = wrapped.PointData[&#x22;X&#x22;]&#xa;Yd = wrapped.PointData[&#x22;Y&#x22;]&#xa;Zd = wrapped.PointData[&#x22;Z&#x22;]&#xa;&#xa;# directors&#xa;H1 = wrapped.PointData[&#x22;H1&#x22;]&#xa;H2 = wrapped.PointData[&#x22;H2&#x22;]&#xa;H3 = wrapped.PointData[&#x22;H3&#x22;]&#xa;&#xa;# ---------------------------------------------------&#xa;# CONNECTIVITY-BASED ORDERING&#xa;# ---------------------------------------------------&#xa;&#xa;npts = pts_ref.shape[0]&#xa;&#xa;neighbors = [[] for _ in range(npts)]&#xa;&#xa;for i in range(inp.GetNumberOfCells()):&#xa;&#xa;    cell = inp.GetCell(i)&#xa;&#xa;    ids = cell.GetPointIds()&#xa;&#xa;    # keep only line cells&#xa;    if ids.GetNumberOfIds() != 2:&#xa;        continue&#xa;&#xa;    a = ids.GetId(0)&#xa;    b = ids.GetId(1)&#xa;&#xa;    neighbors[a].append(b)&#xa;    neighbors[b].append(a)&#xa;&#xa;# find one endpoint&#xa;start = 0&#xa;&#xa;for i in range(npts):&#xa;&#xa;    if len(neighbors[i]) == 1:&#xa;        start = i&#xa;        break&#xa;&#xa;# walk along curve&#xa;order = []&#xa;&#xa;current = start&#xa;prev = -1&#xa;&#xa;while True:&#xa;&#xa;    order.append(current)&#xa;&#xa;    nxts = [x for x in neighbors[current] if x != prev]&#xa;&#xa;    if len(nxts) == 0:&#xa;        break&#xa;&#xa;    nxt = nxts[0]&#xa;&#xa;    prev = current&#xa;    current = nxt&#xa;&#xa;# ---------------------------------------------------&#xa;# REORDER DATA&#xa;# ---------------------------------------------------&#xa;&#xa;s  = s[order]&#xa;&#xa;Xd = Xd[order]&#xa;Yd = Yd[order]&#xa;Zd = Zd[order]&#xa;&#xa;H1 = H1[order]&#xa;H2 = H2[order]&#xa;H3 = H3[order]&#xa;&#xa;# ---------------------------------------------------&#xa;# ENFORCE DIRECTOR CONTINUITY&#xa;# ---------------------------------------------------&#xa;&#xa;for i in range(1, len(H1)):&#xa;&#xa;    hp = np.array([H1[i-1], H2[i-1], H3[i-1]])&#xa;    hc = np.array([H1[i],   H2[i],   H3[i]])&#xa;&#xa;    if np.dot(hp, hc) &#x3c; 0.0:&#xa;&#xa;        H1[i] *= -1.0&#xa;        H2[i] *= -1.0&#xa;        H3[i] *= -1.0&#xa;&#xa;# ---------------------------------------------------&#xa;# NUMBER OF INTERVALS&#xa;# ---------------------------------------------------&#xa;&#xa;N = 50&#xa;&#xa;# total material arc length&#xa;L = np.max(s)&#xa;&#xa;# equally spaced material points&#xa;targets = np.linspace(0.0, L, N+1)&#xa;&#xa;# ---------------------------------------------------&#xa;# OUTPUT&#xa;# ---------------------------------------------------&#xa;&#xa;newPts = vtk.vtkPoints()&#xa;&#xa;Hvec = vtk.vtkDoubleArray()&#xa;Hvec.SetName(&#x22;H&#x22;)&#xa;Hvec.SetNumberOfComponents(3)&#xa;&#xa;# ---------------------------------------------------&#xa;# INTERPOLATION&#xa;# ---------------------------------------------------&#xa;&#xa;for t in targets:&#xa;&#xa;    idx = np.searchsorted(s, t)&#xa;&#xa;    if idx &#x3c;= 0:&#xa;        idx = 1&#xa;&#xa;    if idx &#x3e;= len(s):&#xa;        idx = len(s)-1&#xa;&#xa;    s0 = s[idx-1]&#xa;    s1 = s[idx]&#xa;&#xa;    alpha = 0.0&#xa;&#xa;    if abs(s1-s0) &#x3e; 1e-14:&#xa;        alpha = (t-s0)/(s1-s0)&#xa;&#xa;    # interpolate deformed position&#xa;    px = (1-alpha)*Xd[idx-1] + alpha*Xd[idx]&#xa;    py = (1-alpha)*Yd[idx-1] + alpha*Yd[idx]&#xa;    pz = (1-alpha)*Zd[idx-1] + alpha*Zd[idx]&#xa;&#xa;    newPts.InsertNextPoint(px, py, pz)&#xa;&#xa;    # interpolate director&#xa;    hx = (1-alpha)*H1[idx-1] + alpha*H1[idx]&#xa;    hy = (1-alpha)*H2[idx-1] + alpha*H2[idx]&#xa;    hz = (1-alpha)*H3[idx-1] + alpha*H3[idx]&#xa;&#xa;    Hvec.InsertNextTuple3(hx, hy, hz)&#xa;&#xa;# ---------------------------------------------------&#xa;# CREATE POLYDATA&#xa;# ---------------------------------------------------&#xa;&#xa;poly = vtk.vtkPolyData()&#xa;&#xa;poly.SetPoints(newPts)&#xa;&#xa;poly.GetPointData().AddArray(Hvec)&#xa;&#xa;# make H active vector field&#xa;poly.GetPointData().SetActiveVectors(&#x22;H&#x22;)&#xa;&#xa;out.ShallowCopy(poly)"/>
      </Property>
